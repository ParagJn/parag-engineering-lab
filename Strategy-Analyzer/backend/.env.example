# --- IBM ICA (default provider) ---
IBM_ICA_ENDPOINT=
IBM_ICA_API_KEY=
IBM_ICA_MODEL_ID=claude-opus-5-5
# Optional: a Gemini model on ICA for the cost challenger (falls back to IBM_ICA_MODEL_ID)
IBM_ICA_GEMINI_MODEL_ID=
# Optional per-role overrides (fall back to IBM_ICA_MODEL_ID)
IBM_ICA_VALIDATOR_MODEL_ID=
IBM_ICA_SYNTHESIZER_MODEL_ID=
# Retried once when a reply is blocked by the content filter
IBM_ICA_FALLBACK_MODEL_ID=claude-sonnet-5
# Local connectivity testing only
# IBM_ICA_INSECURE_TLS=true

# --- SAP AI Core + Azure OpenAI (alternative provider) ---
AZURE_OPENAI_GPT54_BASE=
AZURE_OPENAI_GPT54_KEY=
AZURE_OPENAI_GPT54_VERSION=2025-04-01-preview
AZURE_OPENAI_GPT54_DEPLOYMENT=gpt-5.4-common
AZURE_OPENAI_GPT54_RESOURCE_GROUP=
AZURE_OPENAI_GPT54_REGION=

AZURE_OPENAI_GPT53CODEX_BASE=
AZURE_OPENAI_GPT53CODEX_KEY=
AZURE_OPENAI_GPT53CODEX_VERSION=2025-04-01-preview
AZURE_OPENAI_GPT53CODEX_DEPLOYMENT=gpt-5.3-codex-common
AZURE_OPENAI_GPT53CODEX_RESOURCE_GROUP=
AZURE_OPENAI_GPT53CODEX_REGION=

SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=
SAP_API_URL=
SAP_RESOURCE_GROUP=genius
SAP_MODEL_DISCOVERY_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com/v2/lm/scenarios/foundation-models/models
SAP_ANTHROPIC_MODEL=anthropic--claude-4.7-opus
SAP_GEMINI_MODEL=gemini-2.5-pro
SAP_THINKING_MODE=adaptive
SAP_THINKING_BUDGET_TOKENS=12000

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
MAX_IMAGES_PER_DOCUMENT=20
