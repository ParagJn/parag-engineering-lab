{
  "name": "skills-generator-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"http-server ./public -p 3000 -c-1 -P http://localhost:8000\"",
    "start": "http-server ./public -p 3000 -c-1 -P http://localhost:8000"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "http-server": "^14.1.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
