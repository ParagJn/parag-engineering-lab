# Skills Generator — IBM ICA is the only model provider.
# Copy to .env (project root) and fill in the values.

IBM_ICA_API_KEY=
IBM_ICA_ENDPOINT=

# Model used for Anthropic and ChatGPT skills
IBM_ICA_MODEL_ID=claude-opus-5-5
# Model used for Gemini skills
IBM_ICA_GEMINI_MODEL_ID=gemini-3.7-flash

# Optional
# IBM_ICA_INSECURE_TLS=false
# MODEL_TIMEOUT=300              # seconds per model call (bundles are long)
# MAX_TOKENS=8000                # default output tokens for short calls
# GENERATION_MAX_TOKENS=16000    # output tokens when writing a full skill bundle
# MAX_REPAIR_ROUNDS=2            # validate -> fix rounds before saving
# CLAUDE_PERSONAL_SKILLS_DIR=~/.claude/skills   # target of "Install to ~/.claude/skills"
