{
  "app": {
    "title": "Document Comparison Tool",
    "description": "Upload two files (PDF, DOCX, or image) and generate a detailed, section-by-section comparison report."
  },
  "pdf": {
    "max_pages": 300,
    "max_characters_for_llm": 180000,
    "include_page_markers": true,
    "docx_paragraphs_per_section": 8,
    "image_markup_max_output_tokens": 3000
  },
  "llm": {
    "max_output_tokens": 7000,
    "report_style": "detailed"
  },
  "report": {
    "show_raw_text_preview": false,
    "summary_top_n": 12
  }
}
