# SDLC Workbench - backend configuration
# Copy to .env and fill in the blanks. .env is gitignored.
# All four model families go through IBM ICA, with the same variable names as the other lab apps.

# ---- Shared ICA access (one endpoint and key for every model) ----------------
IBM_ICA_ENDPOINT=
IBM_ICA_API_KEY=
# GPT models use this key instead of the one above. Leave blank to use the shared key for them too.
# Only models served by the OpenAI slot get it: if a GPT request falls back to Sonnet, Sonnet is
# called with the shared key, never this one.
IBM_ICA_OPENAI_API_KEY=

# ---- Model slots ------------------------------------------------------------
# One model ID per slot, exactly as ICA names it. Roles in docs/03 map onto these slots.
# A blank slot falls back to its *_FALLBACK_MODEL_ID (flagged in the UI). Blank fallback = no fallback.
# Prices are USD per million tokens, used only for the cost estimate. A blank price shows cost
# as "unknown" (never zero). Reference values and dates are in docs/07-model-config.md.

# Sonnet slot: reasoning roles (planner, requirements, architect, security, triage)
IBM_ICA_MODEL_ID=claude-sonnet-5-5
IBM_ICA_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_PRICE_INPUT_PER_MTOK=2.00
IBM_ICA_PRICE_OUTPUT_PER_MTOK=10.00

# Haiku slot: bulk and templated roles (backlog, diagrams, database, handover)
IBM_ICA_HAIKU_MODEL_ID=claude-haiku-5-5
IBM_ICA_HAIKU_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_HAIKU_PRICE_INPUT_PER_MTOK=0.10
IBM_ICA_HAIKU_PRICE_OUTPUT_PER_MTOK=0.50

# OpenAI slot: code roles (backend developer, test engineer, DevOps)
IBM_ICA_OPENAI_MODEL_ID=gpt-6.1-sol
IBM_ICA_OPENAI_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_OPENAI_PRICE_INPUT_PER_MTOK=2.00
IBM_ICA_OPENAI_PRICE_OUTPUT_PER_MTOK=10.00

# Gemini slot: UX designer, frontend developer (price to be added once known)
IBM_ICA_GEMINI_MODEL_ID=gemini-3.7-flash
IBM_ICA_GEMINI_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_GEMINI_PRICE_INPUT_PER_MTOK=
IBM_ICA_GEMINI_PRICE_OUTPUT_PER_MTOK=

# ---- Run behaviour ----------------------------------------------------------
# replay = serve recorded responses, no keys needed. live = call the models.
APP_MODE=replay
# Which folder of recorded replies to use (backend/recordings/<name>). Letters, digits, - and _ only.
REPLAY_SET=demo
# In live mode, save every successful reply into that set so it can be replayed offline later.
# Recordings contain full prompts, so they are gitignored. Leave off unless you are recording a set.
RECORD_LIVE_CALLS=false
# Replay speed: 0 = instant, 0.25 = a quarter of the recorded time (parallel agents look busy), 1 = real time.
REPLAY_PACE=0
# Hard stop for a single project run, in USD (estimate, from the price table)
RUN_BUDGET_USD=5.00
LLM_TIMEOUT_SECONDS=180
# Retries on the same model for timeouts, rate limits and server errors, before any fallback
LLM_MAX_RETRIES=1
# Wait before retry n is this many seconds times 2^(n-1), capped at 10
LLM_RETRY_BACKOFF_SECONDS=1.0

# Leave these two alone unless the live check tells you to change them.
# IBM_ICA_INSECURE_TLS=true turns certificate checking OFF. Local connectivity testing only.
IBM_ICA_INSECURE_TLS=false
# The browser-style label the other lab apps send (some gateways reject Python's default label).
# IBM_ICA_USER_AGENT=
